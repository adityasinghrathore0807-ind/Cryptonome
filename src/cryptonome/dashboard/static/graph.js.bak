/* Cryptonome link-analysis graph.
 * Uses precomputed node coordinates; does not calculate risk scores or fetch data.
 * Untrusted values are inserted as text, never as HTML.
 */
(function (global) {
    "use strict";

    var SVG_NS = "http://www.w3.org/2000/svg";
    var instanceId = 0;

    var EDGE_COLORS = {
        spend: "#2563eb",
        pay: "#0d9488",
        seen: "#f59e0b",
        in_asn: "#a78bfa"
    };

    function svgElement(name, attrs, parent) {
        var element = document.createElementNS(SVG_NS, name);

        Object.keys(attrs || {}).forEach(function (key) {
            element.setAttribute(key, attrs[key]);
        });

        if (parent) parent.appendChild(element);
        return element;
    }

    function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
    }

    function riskColor(risk) {
        if (typeof risk !== "number" || !Number.isFinite(risk)) {
            return "#94a3b8";
        }

        risk = clamp(risk, 0, 1);

        if (risk < 0.5) {
            var t = risk * 2;
            return "rgb(" +
                Math.round(34 + (245 - 34) * t) + "," +
                Math.round(197 + (158 - 197) * t) + "," +
                Math.round(94 + (11 - 94) * t) + ")";
        }

        var t2 = (risk - 0.5) * 2;
        return "rgb(" +
            Math.round(245 + (220 - 245) * t2) + "," +
            Math.round(158 + (38 - 158) * t2) + "," +
            Math.round(11 + (38 - 11) * t2) + ")";
    }

    function render(container, payload, options) {
        if (!container) {
            throw new Error("CryptonomeGraph.render requires a container element.");
        }

        options = options || {};
        container.textContent = "";
        container.style.position = "relative";

        var width = 900;
        var height = Number(options.height) || 520;
        var padding = 36;
        var graphId = "cryptonome-" + (++instanceId);

        if (!payload || !Array.isArray(payload.nodes) || payload.nodes.length === 0) {
            var emptyMessage = document.createElement("div");
            emptyMessage.textContent = "No graph data for this selection.";
            emptyMessage.style.cssText =
                "padding:24px;color:#64748b;font:14px system-ui,sans-serif";
            container.appendChild(emptyMessage);
            return;
        }

        var nodes = payload.nodes;
        var edges = Array.isArray(payload.edges) ? payload.edges : [];
        var nodeById = Object.create(null);
        var adjacency = Object.create(null);

        nodes.forEach(function (node) {
            if (!node || node.id == null) return;

            var x = Number(node.x);
            var y = Number(node.y);

            node._x = padding + clamp(Number.isFinite(x) ? x : 0.5, 0, 1) *
                (width - padding * 2);
            node._y = padding + clamp(Number.isFinite(y) ? y : 0.5, 0, 1) *
                (height - padding * 2);

            nodeById[node.id] = node;
            adjacency[node.id] = Object.create(null);
        });

        var svg = svgElement("svg", {
            viewBox: "0 0 " + width + " " + height,
            width: "100%",
            height: height,
            role: "img",
            "aria-label": "Wallet, transaction, IP address and ASN link-analysis graph"
        }, container);

        svg.style.cssText =
            "display:block;background:#f8fafc;border:1px solid #e2e8f0;" +
            "border-radius:10px;cursor:grab;touch-action:none;";

        var defs = svgElement("defs", {}, svg);

        Object.keys(EDGE_COLORS).forEach(function (kind) {
            var marker = svgElement("marker", {
                id: graphId + "-" + kind,
                viewBox: "0 0 10 10",
                refX: 9,
                refY: 5,
                markerWidth: 5,
                markerHeight: 5,
                orient: "auto"
            }, defs);

            svgElement("path", {
                d: "M0,0 L10,5 L0,10 z",
                fill: EDGE_COLORS[kind]
            }, marker);
        });

        var rootGroup = svgElement("g", {}, svg);
        var edgeGroup = svgElement("g", {}, rootGroup);
        var nodeGroup = svgElement("g", {}, rootGroup);
        var renderedEdges = [];

        edges.forEach(function (edge) {
            if (!edge) return;

            var source = nodeById[edge.s];
            var target = nodeById[edge.t];

            if (!source || !target) return;

            adjacency[source.id][target.id] = true;
            adjacency[target.id][source.id] = true;

            var color = EDGE_COLORS[edge.kind] || "#94a3b8";
            var line = svgElement("line", {
                x1: source._x,
                y1: source._y,
                x2: target._x,
                y2: target._y,
                stroke: color,
                "stroke-width": 1.4,
                "stroke-opacity": 0.65,
                "marker-end": EDGE_COLORS[edge.kind]
                    ? "url(#" + graphId + "-" + edge.kind + ")"
                    : ""
            }, edgeGroup);

            renderedEdges.push({
                element: line,
                sourceId: source.id,
                targetId: target.id
            });
        });

        var tooltip = document.createElement("div");
        tooltip.style.cssText =
            "position:absolute;display:none;pointer-events:none;z-index:5;" +
            "max-width:320px;padding:8px 10px;border-radius:8px;" +
            "background:#0f172a;color:#f1f5f9;font:12px/1.45 system-ui,sans-serif;" +
            "box-shadow:0 4px 14px rgba(0,0,0,.25);overflow-wrap:anywhere;";
        container.appendChild(tooltip);

        function tooltipLines(node) {
            var lines = [
                String(node.kind || "node").toUpperCase() + "  " +
                String(node.full == null ? node.label || node.id : node.full)
            ];

            if (node.kind === "wallet") {
                lines.push(
                    typeof node.risk === "number" && Number.isFinite(node.risk)
                        ? "Risk " + node.risk.toFixed(2)
                        : "Not scored"
                );
            }

            if (node.kind === "ip") {
                lines.push(
                    (node.country || "Unknown country") +
                    (node.asn != null ? " · AS" + node.asn : "") +
                    (node.org ? " · " + node.org : "")
                );
            }

            if (node.kind === "tx" && node.amount != null) {
                lines.push(String(node.amount) + " BTC");
            }

            if (node.kind === "asn" && node.org) {
                lines.push(String(node.org));
            }

            return lines;
        }

        function setHighlight(enabled, selectedNode) {
            Array.prototype.forEach.call(nodeGroup.children, function (group) {
                var keep = !enabled ||
                    group.__nodeId === selectedNode.id ||
                    adjacency[selectedNode.id][group.__nodeId];

                group.setAttribute("opacity", keep ? "1" : "0.15");
            });

            renderedEdges.forEach(function (edge) {
                var connected = edge.sourceId === selectedNode.id ||
                    edge.targetId === selectedNode.id;

                edge.element.setAttribute(
                    "stroke-opacity",
                    !enabled || connected ? "0.9" : "0.06"
                );
            });
        }

        nodes.forEach(function (node) {
            if (!node || node.id == null) return;

            var group = svgElement("g", {
                transform: "translate(" + node._x + "," + node._y + ")"
            }, nodeGroup);

            group.__nodeId = node.id;
            group.style.cursor = "pointer";

            var isFocus = node.id === payload.focus;
            var kind = node.kind || "asn";
            var shape;

            if (kind === "wallet") {
                var risk = typeof node.risk === "number" &&
                    Number.isFinite(node.risk) ? clamp(node.risk, 0, 1) : null;

                shape = svgElement("circle", {
                    r: 6 + 9 * (risk || 0) + (isFocus ? 3 : 0),
                    fill: risk === null ? "#cbd5e1" : riskColor(risk),
                    stroke: isFocus ? "#0f172a" : "#ffffff",
                    "stroke-width": isFocus ? 3 : 1.5
                }, group);
            } else if (kind === "tx") {
                shape = svgElement("rect", {
                    x: -4,
                    y: -4,
                    width: 8,
                    height: 8,
                    fill: "#94a3b8",
                    stroke: "#ffffff",
                    "stroke-width": 1
                }, group);
            } else if (kind === "ip") {
                shape = svgElement("polygon", {
                    points: "0,-9 9,0 0,9 -9,0",
                    fill: "#f59e0b",
                    stroke: "#ffffff",
                    "stroke-width": 1.5
                }, group);
            } else {
                shape = svgElement("polygon", {
                    points: "0,-8 8,6 -8,6",
                    fill: "#a78bfa",
                    stroke: "#ffffff",
                    "stroke-width": 1.5
                }, group);
            }

            if (kind !== "tx") {
                var label = svgElement("text", {
                    y: kind === "wallet"
                        ? -14 - 9 * (Number(node.risk) || 0)
                        : 18,
                    "text-anchor": "middle",
                    "font-size": isFocus ? 11 : 9.5,
                    "font-family": "ui-monospace,Menlo,monospace",
                    "font-weight": isFocus ? 700 : 400,
                    fill: "#334155",
                    "paint-order": "stroke",
                    stroke: "#f8fafc",
                    "stroke-width": 3
                }, group);

                label.textContent = String(node.label == null ? node.id : node.label);
            }

            group.addEventListener("mouseenter", function () {
                tooltip.textContent = "";

                tooltipLines(node).forEach(function (lineText, index) {
                    var line = document.createElement("div");
                    line.textContent = lineText;

                    if (index === 0) {
                        line.style.fontWeight = "600";
                    }

                    tooltip.appendChild(line);
                });

                tooltip.style.display = "block";
                setHighlight(true, node);
            });

            group.addEventListener("mousemove", function (event) {
                var bounds = container.getBoundingClientRect();
                var left = event.clientX - bounds.left + 14;
                var top = event.clientY - bounds.top + 14;

                tooltip.style.left = Math.max(
                    4,
                    Math.min(left, bounds.width - tooltip.offsetWidth - 4)
                ) + "px";

                tooltip.style.top = Math.max(4, top) + "px";
            });

            group.addEventListener("mouseleave", function () {
                tooltip.style.display = "none";
                setHighlight(false, node);
            });

            group.addEventListener("click", function (event) {
                event.stopPropagation();
                if (typeof options.onSelect === "function") {
                    options.onSelect(node);
                }
            });
        });

        var view = { x: 0, y: 0, scale: 1 };

        function applyView() {
            rootGroup.setAttribute(
                "transform",
                "translate(" + view.x + "," + view.y + ") scale(" + view.scale + ")"
            );
        }

        function resetView() {
            view = { x: 0, y: 0, scale: 1 };
            applyView();
        }

        container.__reset = resetView;

        if (global.d3 && global.d3.zoom && global.d3.select) {
            var zoom = global.d3.zoom()
                .scaleExtent([0.4, 10])
                .on("zoom", function (event) {
                    rootGroup.setAttribute("transform", event.transform.toString());
                });

            global.d3.select(svg).call(zoom);

            container.__reset = function () {
                global.d3.select(svg).call(
                    zoom.transform,
                    global.d3.zoomIdentity
                );
            };
        } else {
            svg.addEventListener("wheel", function (event) {
                event.preventDefault();

                var bounds = svg.getBoundingClientRect();
                var scaleX = width / bounds.width;
                var pointerX = (event.clientX - bounds.left) * scaleX;
                var pointerY = (event.clientY - bounds.top) * scaleX;

                var nextScale = clamp(
                    view.scale * (event.deltaY < 0 ? 1.15 : 1 / 1.15),
                    0.4,
                    10
                );

                var ratio = nextScale / view.scale;
                view.x = pointerX - (pointerX - view.x) * ratio;
                view.y = pointerY - (pointerY - view.y) * ratio;
                view.scale = nextScale;

                applyView();
            }, { passive: false });

            var drag = null;

            svg.addEventListener("pointerdown", function (event) {
                if (event.button !== 0) return;

                drag = {
                    startX: event.clientX,
                    startY: event.clientY,
                    viewX: view.x,
                    viewY: view.y
                };

                svg.setPointerCapture(event.pointerId);
                svg.style.cursor = "grabbing";
            });

            svg.addEventListener("pointermove", function (event) {
                if (!drag) return;

                var bounds = svg.getBoundingClientRect();
                var scaleX = width / bounds.width;

                view.x = drag.viewX + (event.clientX - drag.startX) * scaleX;
                view.y = drag.viewY + (event.clientY - drag.startY) * scaleX;
                applyView();
            });

            function endDrag() {
                drag = null;
                svg.style.cursor = "grab";
            }

            svg.addEventListener("pointerup", endDrag);
            svg.addEventListener("pointercancel", endDrag);
            svg.addEventListener("lostpointercapture", endDrag);
        }

        var legend = document.createElement("div");
        legend.style.cssText =
            "position:absolute;left:10px;bottom:10px;display:flex;gap:10px;" +
            "flex-wrap:wrap;padding:5px 9px;border-radius:8px;" +
            "background:rgba(255,255,255,.92);border:1px solid #e2e8f0;" +
            "font:11px system-ui,sans-serif;color:#334155;";

        [
            ["●", "#dc2626", "Wallet (colour = risk)"],
            ["■", "#94a3b8", "Transaction"],
            ["◆", "#f59e0b", "IP address"],
            ["▲", "#a78bfa", "ASN"]
        ].forEach(function (item) {
            var entry = document.createElement("span");
            var symbol = document.createElement("b");

            symbol.textContent = item[0];
            symbol.style.color = item[1];

            entry.appendChild(symbol);
            entry.appendChild(document.createTextNode(" " + item[2]));
            legend.appendChild(entry);
        });

        container.appendChild(legend);

        var resetButton = document.createElement("button");
        resetButton.type = "button";
        resetButton.textContent = "Reset view";
        resetButton.style.cssText =
            "position:absolute;right:10px;top:10px;padding:4px 9px;" +
            "border-radius:7px;border:1px solid #cbd5e1;background:#ffffff;" +
            "font:11px system-ui,sans-serif;cursor:pointer;";

        resetButton.addEventListener("click", function () {
            container.__reset();
        });

        container.appendChild(resetButton);
    }

    global.CryptonomeGraph = {
        render: render,
        riskColor: riskColor
    };
})(typeof window !== "undefined" ? window : this);
